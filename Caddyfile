{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Vite fingerprints everything under /assets.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# Routing is hash-based, so unknown paths are 404s, not SPA fallbacks.
	file_server
}
