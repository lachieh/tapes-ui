{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# The page is requested as "/", so match that as well as /index.html;
	# otherwise browsers cache it heuristically and keep old bundles after a deploy.
	@page path / /index.html
	header @page Cache-Control "no-cache"

	file_server
}
